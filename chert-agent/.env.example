# Copy to .env.local and fill in privately. Never commit .env.local.
# All three LiveKit values must belong to one LiveKit project (cloud.livekit.io -> your project -> Settings -> Keys).
# On a Chert Shared plan with Chert rooms, leave all three empty: calls then run in Chert's LiveKit.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Gemini key (same as the iCare app's GEMINI_API_KEY). Powers Gemini Live voice.
GEMINI_API_KEY=

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=idoc-checkin

# Where the iCare app runs (check-in prompt + emergency check). Local dev server, or https://icare-wall-e9.vercel.app once merged.
IDOC_API_URL=http://localhost:3001
# Optional overrides (defaults: gemini-2.5-flash-native-audio-preview-12-2025, Aoede)
GEMINI_LIVE_MODEL=
GEMINI_LIVE_VOICE=
