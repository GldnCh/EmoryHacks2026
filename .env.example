# Copy this file to .env.local and fill in the values. Never commit .env.local.
# TD has the team's API keys; Cam has TIGER_DATABASE_URL. Ask privately. Details: docs/API-KEYS.md

# Gemini (from TD) - server-only
GEMINI_API_KEY=
# Optional: override the default model
GEMINI_MODEL=

# Typesense Cloud (from TD) - host without https://, e.g. xyz.a1.typesense.net
TYPESENSE_HOST=
TYPESENSE_API_KEY=
# Search-only key, safe for the browser
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=

# Tiger Data / TimescaleDB (from Cam) - secret, server-only
TIGER_DATABASE_URL=

# Chert - add variable names here once we have Chert's docs

# openFDA (optional) - only needed if we hit the free daily limit
OPENFDA_API_KEY=
