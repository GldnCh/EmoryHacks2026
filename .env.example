# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Cam holds and sends all keys privately (teammates get a read-only database login). Details: docs/API-KEYS.md

# Gemini (from Cam) - server-only
GEMINI_API_KEY=
# Optional: override the default model (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Typesense Cloud (from Cam) - host without https://, e.g. xyz.a1.typesense.net
TYPESENSE_HOST=
TYPESENSE_API_KEY=
# Search-only key, safe for the browser
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=

# Tiger Data / TimescaleDB (from Cam; teammates get the read-only idoc_team login) - secret, server-only
TIGER_DATABASE_URL=

# Chert FaceTime agent: its variables live in chert-agent/.env.example (LIVEKIT_URL, LIVEKIT_API_KEY,
# LIVEKIT_API_SECRET, GEMINI_API_KEY, AGENT_NAME, IDOC_API_URL). The web app itself needs no Chert keys. See docs/CHERT.md

# Chert agent token (from Cam): lets only the FaceTime agent save check-in summaries (POST /api/ai/call-summary)
CHERT_AGENT_TOKEN=

# openFDA (optional) - only needed if we hit the free daily limit
OPENFDA_API_KEY=
