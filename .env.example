# Copy this file to .env.local and fill in the values. Never commit .env.local.
# How to get each key: docs/API-KEYS.md

# Gemini (owner: Ish)
GEMINI_API_KEY=
# Optional: override the default model
GEMINI_MODEL=

# Typesense Cloud (owner: Jam) - host without https://, e.g. xyz.a1.typesense.net
TYPESENSE_HOST=
TYPESENSE_API_KEY=
# Search-only key, safe for the browser
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=

# Supabase (owner: Jam)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chert (owner: Ish) - add variable names here once you have Chert's docs

# Tiger Data / TimescaleDB (owner: Jam) - health history time series. Secret, server-only.
TIGER_DATABASE_URL=

# openFDA (optional) - only needed if we hit the free daily limit
OPENFDA_API_KEY=
